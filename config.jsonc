{
  // Paths are resolved relative to this file.
  // Create the ignored runtime tree once with: cp -R run-template run
  "opencode": {
    "configDir": "./run/config",
    "cacheDir": "./run/cache",
    "initScript": "./run/opencode/init.sh",
    "tag": "ced73dc0f6c5b00c3a085b1d7b11ea31f790c5df",
    "port": 14096
  },
  "sandbox": {
    // Provider name or a path to a base *.qcow2 (sibling *.kernel/*.initrd
    // required) — see README. The saved image is <name-or-stem>-<imageTag>.
    "image": "ubuntu",
    "imageTag": "default",
    // Scratch directory on the host; screenshots land in ${tmpDir}/screenshots.
    "tmpDir": "./.quicksand/tmp",
    // Port of the sandbox API server (127.0.0.1 only): /api/exec,
    // /api/capabilities, /api/screenshot.
    "apiPort": 15222,
    "cpus": 1,
    "memory": "512M",
    "diskSize": "10G",
    "enableDisplay": false,
    "initScript": "./run/sandbox/init.sh",
    "cacheDir": "./.quicksand/sandboxes",
    "mounts": [
      { "host": "./cache/.m2", "guest": "/root/.m2" }
    ],
    "env": {
      "MAVEN_OPTS": "-Dmaven.repo.local=/root/.m2"
    },
    "portMapping": [
      { "from": "Host(8080)", "to": "Guest(8080)" }
    ]
  }
}
